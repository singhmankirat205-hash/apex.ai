# ============================================================
# APEX — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Anthropic API ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Claude model to use (claude-sonnet-4-5 recommended)
CLAUDE_MODEL=claude-sonnet-4-5

# Max tokens per response (increase for detailed reports)
MAX_TOKENS=2048

# ── Plant Configuration ──────────────────────────────────────
PLANT_NAME=Your Textile Plant Pvt. Ltd.
UNIT_LIST=Unit A (Weaving), Unit B (Dyeing), Unit C (Knitting)
QA_HEAD=Mr. / Ms. <QA Head Name>

# Machine types in your plant
MACHINE_TYPES=air-jet loom, rapier loom, circular knitting machine, flat knitting machine

# Fabric types processed
FABRIC_TYPES=cotton, poly-cotton, viscose, denim, polyester

# Defect taxonomy (SME-approved list — comma separated)
DEFECT_TAXONOMY=broken pick, missing end, slub, hole, needle line, oil stain, thick/thin place, barre, shade variation, uneven dyeing, creasing, GSM deviation, shrinkage deviation, stitch/knit fault

# Inspection standard
INSPECTION_SYSTEM=4-Point System

# Safety thresholds (triggers critical escalation)
CRITICAL_THRESHOLDS=bearing temp > 110 °C, vibration > 8 mm/s

# Repeat defect window for mandatory escalation
REPEAT_WINDOW=7 days

# ── Plant API (your internal data APIs) ─────────────────────
# Base URL for your plant's REST API
# All tool functions in backend/tools/plant_tools.py use this.
PLANT_API_BASE_URL=http://localhost:8000/api/v1

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000
